# ─────────────────────────────────────────────
# AirFare Scraper — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Database ────────────────────────────────
# SQLite (dev/prototype):
DATABASE_URL=sqlite:///./data/airfare.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/airfare_db

# ── Proxy Settings ──────────────────────────
# Indian travel sites block headless browsers by IP.
# Use free residential proxies from https://proxy.webshare.io (10 free)
# Step 1: Download proxy list from Webshare dashboard
# Step 2: Run: python tools/import_webshare_proxies.py webshare_list.txt
# Step 3: Set PROXY_ENABLED=true below
PROXY_ENABLED=false
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
# Alternatively, put proxies one per line in proxies.txt (http://user:pass@host:port)

# ── Scraper Behavior ────────────────────────
HEADLESS=false          # Running visible browser bypasses heavy bot detection
MAX_CONCURRENT_SCRAPERS=1  # Keep at 1 — parallel requests trigger IP bans
REQUEST_DELAY_MIN=15.0  # Extreme delay to simulate human typing/reading
REQUEST_DELAY_MAX=30.0  # Extreme delay to simulate human typing/reading
SCRAPE_RETRY_ATTEMPTS=2
SCRAPE_RETRY_DELAY=30   # seconds between retries

# ── Scheduling ──────────────────────────────
# Cron expression for auto-scraping (default: 6am, 12pm, 6pm daily)
SCRAPE_CRON=0 6,12,18 * * *

# ── Look-ahead window ───────────────────────
# Scrape fares for flights departing D+MIN to D+MAX days from today
LOOKAHEAD_DAYS_MIN=1
LOOKAHEAD_DAYS_MAX=60

# ── Logging ─────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
